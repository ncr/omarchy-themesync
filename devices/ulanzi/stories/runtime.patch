 }
 
 /// a json body for one of the schemas; shared by http routes and mqtt command topics.
@@ -2528,3 +2533,13 @@ test "a font on a document notification is refused: each text element names its
     const ok = route(testReq(.POST, "/api/v1/notify", "", control_header, "application/json", null), "{\"font\":\"tiny5\",\"text\":\"hi\"}", &c, &no_clients, &origins, &arena, test_minted);
     try std.testing.expect(ok == .op);
 }
+
+
+test "continuous HTTP frames use the stream channel only by explicit opt-in" {
+    const frame: [geometry.rgb_bytes]u8 = @splat(7);
+    const live = parseFrame("duration_s=1&stream=1", &frame, generated_mask | 1);
+    try std.testing.expect(live.op.frame.stream);
+    const discrete = parseFrame("duration_s=1", &frame, generated_mask | 2);
+    try std.testing.expect(!discrete.op.frame.stream);
+    try expectReject(parseFrame("duration_s=1&stream=true", &frame, generated_mask | 3), 400, "invalid_stream");
+}
