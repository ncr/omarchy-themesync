 extern fn be_pop(vm: *Bvm, n: c_int) void;
+extern fn be_remove(vm: *Bvm, index: c_int) void;
 
 test "a nul-terminated copy hands over the bytes, not the address of the pointer holding them" {
     // berry takes `[*:0]const u8`, so every string handed to it is copied and terminated first.
@@ -494,6 +518,7 @@ pub const Arg = union(enum) { none, int: i64, text: [*:0]const u8 };
 /// call a global berry function with up to three arguments, under the watchdog's deadline.
 /// returns false when the call raised, having left the message where `errorText` can find it.
 pub fn callGlobal(vm: *vm_mod.Vm, name: [*:0]const u8, args: []const Arg, budget_ns: u64) bool {
+    const baseline = be_top(vm.handle);
     if (!be_getglobal(vm.handle, name)) return false;
     for (args) |a| switch (a) {
         .none => be_pushnil(vm.handle),
@@ -503,7 +528,16 @@ pub fn callGlobal(vm: *vm_mod.Vm, name: [*:0]const u8, args: []const Arg, budget
     if (vm_mod.clock) |f| vm_mod.deadline_ns = f() + budget_ns;
     defer vm_mod.deadline_ns = 0;
     const st: vm_mod.Status = @fromBackingInt(@intCast(be_pcall(vm.handle, @intCast(args.len))));
-    if (st != .ok) return false;
-    be_pop(vm.handle, 1); // the return value; nothing here wants it
+    if (st != .ok) {
+        // A protected exception appends its pair above the original function and arguments.
+        // Keep that pair for errorText/clearError, removing the call's retained values below it.
+        if (st == .exception) {
+            while (be_top(vm.handle) > baseline + 2) be_remove(vm.handle, baseline + 1);
+        }
+        return false;
+    }
+    // Berry replaces the function slot with the result, but retains every argument on the
+    // virtual stack. Popping one value leaked one slot per timer argument (four per button).
+    be_pop(vm.handle, be_top(vm.handle) - baseline);
     return true;
 }
diff --git c/runtime/src/berry_stack_regression.zig w/runtime/src/berry_stack_regression.zig
new file mode 100644
index 0000000..1922dd2
--- /dev/null
+++ w/runtime/src/berry_stack_regression.zig
@@ -0,0 +1,44 @@
+const std = @import("std");
+const berry = @import("berry/vm.zig");
+const api = @import("berry/api.zig");
+const canvas = @import("scene/canvas.zig");
+const messages = @import("ipc/messages.zig");
+extern fn be_top(vm: *berry.Bvm) c_int;
+var sprite_rendered = false;
+fn capture(message: messages.Message) void {
+    if (message == .stream_frame) {
+        const rgb = message.stream_frame.rgb;
+        sprite_rendered = rgb[0] == 255 and rgb[1] == 0 and rgb[2] == 80;
+    }
+}
+
+pub fn main() !void {
+    berry.heapInit(256);
+    var vm = berry.Vm.init() orelse return error.NoVm;
+    defer vm.deinit();
+    if (vm.run("setup", "def tick(a) return a end\ndef edge(a,b,c,d) return nil end\ndef broken(a) raise 'expected', 'failure' end") != .ok) return error.Setup;
+    const baseline = be_top(vm.handle);
+    for (0..20000) |_| {
+        if (!api.callGlobal(&vm, "tick", &.{.{ .int = 100 }}, 0)) return error.Tick;
+        if (be_top(vm.handle) != baseline) return error.TimerStackGrew;
+        if (!api.callGlobal(&vm, "edge", &.{ .{ .text = "button" }, .{ .text = "right" }, .{ .text = "press" }, .{ .int = 1 } }, 0)) return error.Edge;
+        if (be_top(vm.handle) != baseline) return error.EventStackGrew;
+    }
+    for (0..1000) |_| {
+        if (api.callGlobal(&vm, "broken", &.{.{ .int = 100 }}, 0)) return error.ExpectedFailure;
+        if (!std.mem.eql(u8, vm.errorText(), "failure")) return error.ExceptionLost;
+        vm.clearError();
+        if (be_top(vm.handle) != baseline) return error.ExceptionStackGrew;
+    }
+    if (berry.arena.failures != 0) return error.AllocationFailure;
+    api.register(&vm);
+    api.emit = capture;
+    var sprite = canvas.Sprite{ .id = canvas.Id.init("proof"), .w = 8, .h = 8 };
+    sprite.rgb[0] = 255;
+    sprite.rgb[2] = 80;
+    api.putSprite(sprite);
+    if (vm.run("sprite", api.prelude ++ "\npanel.clear()\npanel.sprite(0,0,'proof')\npanel.push()") != .ok) return error.SpriteScript;
+    if (!sprite_rendered) return error.SpriteMissingFromFramebuffer;
+    std.debug.print("Berry stack regression: 40,000 successful calls and 1,000 exceptions; stack stable, zero allocation failures.\n", .{});
+    std.debug.print("Sprite regression: uploaded sprite pixels are present in the streamed framebuffer.\n", .{});
+}
