+
+/// Continuous RGB streams carry coverage and theme shades. Keep their black-to-peak
+/// ramp linear; the stock nonzero floor destroys antialiasing and lifts dark RGB to white.
+/// Full-scale intensity still matches the user's existing brightness setting.
+pub fn buildLinearLut(brightness: u8) Lut {
+    const peak: u32 = remap(@intCast(@as(u32, @min(brightness, 100)) * 255 / 100));
+    var out: Lut = undefined;
+    for (&out, 0..) |*value, i| value.* = @intCast((i * peak + 127) / 255);
+    return out;
+}
+
+test "continuous stream levels preserve black peak and subpixel coverage" {
+    for ([_]u8{ 0, 5, 35, 55, 100 }) |brightness| {
+        const a = buildLut(brightness);
+        const b = buildLinearLut(brightness);
+        try std.testing.expectEqual(a[255], b[255]);
+        try std.testing.expectEqual(@as(u8, 0), b[0]);
+        for (1..256) |i| try std.testing.expect(b[i] >= b[i - 1]);
+        try std.testing.expect(@abs(@as(i32, b[128]) * 2 - @as(i32, b[255])) <= 1);
+    }
+    try std.testing.expect(buildLinearLut(100)[16] < remap(1));
+}
