--- c/runtime/src/netd_main.zig
+++ w/runtime/src/netd_main.zig
@@ -209,6 +209,8 @@ const Netd = struct {
     mqtt_commands: u32 = 0,
     frames_in_second: u8 = 0,
     frame_second: u64 = 0,
+    stream_frames_in_second: u8 = 0,
+    stream_second: u64 = 0,
 
     fn newId(self: *Netd) u64 {
         self.next_id += 1;
@@ -561,6 +563,18 @@ const Netd = struct {
         return true;
     }
 
+    fn streamAllowed(self: *Netd, now: u64) bool {
+        const second = now / ns_per_s;
+        if (second != self.stream_second) {
+            self.stream_second = second;
+            self.stream_frames_in_second = 0;
+        }
+        // The panel presents at most 60 Hz; tolerate scheduler jitter without dropping a 60 Hz producer.
+        if (self.stream_frames_in_second >= 90) return false;
+        self.stream_frames_in_second += 1;
+        return true;
+    }
+
     /// turn an operation into a relay or an immediate response. shared by http and mqtt.
     fn execute(self: *Netd, c: *Conn, op: api.Op, now: u64) void {
         switch (op) {
@@ -608,13 +622,19 @@ const Netd = struct {
                 if (n.doc) |d| self.relay(c, .{ .notify_rich = .{ .notify = base, .doc = d } }, n.request_id, n.epoch orelse 0, now) else self.relay(c, .{ .notify = base }, n.request_id, n.epoch orelse 0, now);
             },
             .frame => |f| {
-                if (!self.frameAllowed(now)) {
+                if (!(if (f.stream) self.streamAllowed(now) else self.frameAllowed(now))) {
                     c.client_id = f.request_id;
-                    self.respondError(c, 429, "frame_rate", "occasional frames are limited to ten per second");
+                    self.respondError(c, 429, "frame_rate", "frame rate limit exceeded (discrete 10 Hz, stream 90 Hz)");
                     self.flushConn(c, now);
