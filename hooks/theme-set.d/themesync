#!/bin/bash
# Omarchy theme-set hook -> push the new theme to the watch.
#
# Install:  themesync install-hook        (writes this file with the absolute path baked in)
#     or:   omarchy hook install theme-set hooks/theme-set.d/themesync
#
# Omarchy (v4.0.1) runs every ~/.config/omarchy/hooks/theme-set.d/* as `bash <file> <slug>`,
# synchronously, after the theme directory swap and after all app retints. So this must
# return immediately: `sync --async` re-execs themesync detached; that process hands the job
# to the running daemon over its socket (beacon bump + GATT push) or, with no daemon, opens
# a one-shot GATT connection with retries.
THEMESYNC="${THEMESYNC_BIN:-themesync}"
command -v "$THEMESYNC" >/dev/null 2>&1 || exit 0
"$THEMESYNC" sync --async >/dev/null 2>&1 || true
