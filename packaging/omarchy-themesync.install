post_install() {
  cat <<'EOF'
omarchy-themesync: two per-user steps a package cannot do for you (nothing needs root):

  1. As your desktop user, inside the Omarchy session:
        themesync install      # hook + user service + bar widget, then a health check
  2. With the watch nearby:
        themesync pair

  `themesync doctor` checks all of it. Docs: /usr/share/doc/omarchy-themesync/README.md
EOF
}

post_upgrade() {
  cat <<'EOF'
omarchy-themesync: run `themesync doctor` as your desktop user; `systemctl --user restart themesync`
picks up the new binary.
EOF
}

pre_remove() {
  cat <<'EOF'
omarchy-themesync: per-user leftovers are removed with `themesync uninstall` (add --purge to
delete the pairing key in ~/.config/themesync); run it before this package is gone.
EOF
}
