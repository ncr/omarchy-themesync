# User service: broadcast the current Omarchy theme as a BLE beacon, scan for the watch's
# requests, and serve the hook's `sync` over the daemon socket (protocol/BEACON.md).
#
# This is the packaged copy (/usr/lib/systemd/user, binary at /usr/bin). For a cargo-installed
# binary `themesync install` writes the same unit with the binary's real path into
# ~/.config/systemd/user/ and enables it; either way `themesync doctor` checks the result.
#   journalctl --user -u themesync -f
#
# Tied to the graphical session like Omarchy's own user units (bt-agent, fcitx5): `After=` is
# ordering only, so with `WantedBy=default.target` this would start on an SSH login and at
# boot before the session environment (OMARCHY_PATH, WAYLAND_DISPLAY) is imported, and
# omarchy-theme-set would half-apply. Needs bluez (stock configuration) and a BLE 5
# controller (extended advertising).
[Unit]
Description=Omarchy theme beacon + watch request scanner (themesync daemon)
After=bluetooth.target graphical-session.target
PartOf=graphical-session.target
Wants=bluetooth.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathIsDirectory=/sys/class/bluetooth

[Service]
Type=simple
ExecStart=/usr/bin/themesync daemon --no-gatt
# The daemon waits for bluetoothd / a powered adapter itself, with backoff; only a real
# failure (no extended advertising, socket lost) exits, and then a restart is right.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
